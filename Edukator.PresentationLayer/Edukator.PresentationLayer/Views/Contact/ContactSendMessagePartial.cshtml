@{
    Layout = null;
}
<div class="w3l-contact-10 py-5" id="contact">
    <div class="form-41-mian pt-lg-4 pt-md-3 pb-lg-4">
        <div class="container">
            <div class="heading text-center mx-auto">
                <h5 class="title-subw3hny text-center">Ekibimizle iletişime geçin</h5>
                <h3 class="title-w3l">Herhangi bir sorunuz var mı?</h3>
            </div>
            @await Component.InvokeAsync("_ContactInfoPartial")
            <div class="form-inner-cont mt-5">
                <form action="#" method="post" class="signin-form">
                    <div class="form-grids">
                        <div class="form-input">
                            <input type="text" name="Name" placeholder="Adınızı Giriniz"
                                   required="" />
                        </div>
                        <div class="form-input">
                            <input type="text" name="Subject" placeholder="Konu Giriniz "
                                   required />
                        </div>
                        <div class="form-input">
                            <input type="email" name="Sender" placeholder="Mail Adresinizi Giriniz"
                                   required />
                        </div>
                        <div class="form-input">
                            <input type="text" name="Phone" placeholder="Telefon Numaranızı Giriniz"
                                   required />
                        </div>
                    </div>
                    <div class="form-input">
                        <textarea name="Message" placeholder="Sorunuzu buraya yazın"
                                  required=""></textarea>
                    </div>
                    <div class="text-right">
                        <button class="btn btn-style btn-primary">Mesaj Gönder</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <!-- //contacts-5-grid -->
</div>